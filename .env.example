# Production Environment Configuration Template
# 12-Factor App: All config in environment variables
# Copy this file and replace with actual production values

# Application
APP_NAME=demo
PORT=8080
LOG_LEVEL=INFO
APP_LOG_LEVEL=INFO

# PostgreSQL Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://your-db-host:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=your-username
SPRING_DATASOURCE_PASSWORD=your-password
DB_POOL_SIZE=2
# "update" lets Hibernate create the table; use "validate" when you create it yourself.
JPA_DDL_AUTO=update
DB_SCHEMA=public

# Kafka Configuration
# Replace with your production Kafka brokers
KAFKA_BOOTSTRAP_SERVERS=your-kafka-broker:9092
KAFKA_CONSUMER_GROUP_ID=demo-group-prod
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_TOPIC_NAME=demo-topic-prod

# CORS Configuration
# Set to your production frontend URL
CORS_ALLOWED_ORIGINS=https://your-production-domain.com

# Spring Profile
SPRING_PROFILES_ACTIVE=prod

# Shared secret for /api/** (optional). When set, callers must send it in the
# X-Demo-Token header. Leave unset for local development and the bundled UI.
# Generate: openssl rand -hex 32
DEMO_API_TOKEN=
